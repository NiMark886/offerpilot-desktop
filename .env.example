# Compose
OFFERPILOT_HTTP_PORT=8088

# Backend (local MySQL)
JWT_SECRET=replace-with-a-base64-encoded-64-byte-secret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=offerpilot
MYSQL_USER=root
MYSQL_PASSWORD=1234
# Docker 容器内访问宿主 MySQL 的地址；Docker Desktop 默认 host.docker.internal
DOCKER_MYSQL_HOST=host.docker.internal

# AI providers (optional; default uses deterministic mock)
APP_AI_ENABLED=false
DEEPSEEK_API_KEY=
# Encrypts per-user API keys; if empty, derives from JWT_SECRET
AI_SETTINGS_SECRET=
# Allow http/private-network API endpoints; keep false in production
AI_ALLOW_PRIVATE_BASE_URL=false
# Blueprint generation read timeout (ISO-8601 duration)
AI_BLUEPRINT_TIMEOUT=PT25S

# Quota (disabled by default; set true to restore 3 sessions/day for FREE users)
APP_QUOTA_ENFORCE=false
